QMAKE_PRL_TARGET = libQt6Network.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.8.3
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6Core.a -L"$$[QT_INSTALL_PREFIX]/debug/lib" -ldouble-conversion -lb2 -licui18n -licuuc -licudata -lpcre2-16 -lrt -lbrotlidec -lbrotlicommon -lm -lzstd -lz -lresolv -lssl -lcrypto -ldl
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6Core.a;-L"$$[QT_INSTALL_PREFIX]/debug/lib";-ldouble-conversion;-lb2;-licui18n;-licuuc;-licudata;-lpcre2-16;-lrt;-lbrotlidec;-lbrotlicommon;-lm;-lzstd;-lz;-lresolv;-lssl;-lcrypto;-ldl
