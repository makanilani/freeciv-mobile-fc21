QMAKE_PRL_TARGET = libQt6UiTools.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.8.3
QMAKE_PRL_LIBS = -L"$$[QT_INSTALL_PREFIX]/debug/lib" -lQt6OpenGLWidgets -lQt6Widgets -lQt6OpenGL -lQt6Gui -lGLX -lOpenGL -lEGL -lharfbuzz -lfontconfig -lfreetyped -lbz2d -lpng16d -lz -lbz2d -lpng16d -lbrotlidec -lbrotlicommon -lexpat -lX11 -lQt6DBus -lQt6Core -lz -ldouble-conversion -lb2 -lm -licui18n -licuuc -licudata -lpcre2-16 -lzstd -ldl -lrt -ldbus-1 -lxkbcommon
QMAKE_PRL_LIBS_FOR_CMAKE = -L"$$[QT_INSTALL_PREFIX]/debug/lib";-lQt6OpenGLWidgets;-lQt6Widgets;-lQt6OpenGL;-lQt6Gui;-lGLX;-lOpenGL;-lEGL;-lharfbuzz;-lfontconfig;-lfreetyped;-lbz2d;-lpng16d;-lz;-lbz2d;-lpng16d;-lbrotlidec;-lbrotlicommon;-lexpat;-lX11;-lQt6DBus;-lQt6Core;-lz;-ldouble-conversion;-lb2;-lm;-licui18n;-licuuc;-licudata;-lpcre2-16;-lzstd;-ldl;-lrt;-ldbus-1;-lxkbcommon
