QMAKE_PRL_TARGET = libQt6Widgets.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.8.3
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/objects-Debug/Widgets_resources_1/.qt/rcc/qrc_qstyle_init.cpp.o $$[QT_INSTALL_LIBS]/objects-Debug/Widgets_resources_2/.qt/rcc/qrc_qstyle1_init.cpp.o $$[QT_INSTALL_LIBS]/objects-Debug/Widgets_resources_3/.qt/rcc/qrc_qstyle_fusion_init.cpp.o $$[QT_INSTALL_LIBS]/objects-Debug/Widgets_resources_4/.qt/rcc/qrc_qmessagebox_init.cpp.o $$[QT_INSTALL_LIBS]/objects-Debug/Gui_resources_1/.qt/rcc/qrc_qpdf_init.cpp.o $$[QT_INSTALL_LIBS]/objects-Debug/Gui_resources_2/.qt/rcc/qrc_gui_shaders_init.cpp.o $$[QT_INSTALL_LIBS]/libQt6Widgets.a $$[QT_INSTALL_LIBS]/libQt6Gui.a -lGLX -lOpenGL -lEGL -L"$$[QT_INSTALL_PREFIX]/debug/lib" -lharfbuzz -lfontconfig -lfreetyped -lbz2d -lpng16d -lz -lbz2d -lpng16d -lbrotlidec -lbrotlicommon -lexpat -lX11 $$[QT_INSTALL_LIBS]/libQt6DBus.a $$[QT_INSTALL_LIBS]/libQt6Core.a -lz -ldouble-conversion -lb2 -lm -licui18n -licuuc -licudata -lpcre2-16 -lzstd -ldl -lrt -ldbus-1 -lxkbcommon
