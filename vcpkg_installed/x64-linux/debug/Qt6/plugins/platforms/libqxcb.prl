QMAKE_PRL_TARGET = libqxcb.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.8.3
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/objects-Debug/Gui_resources_1/.qt/rcc/qrc_qpdf_init.cpp.o $$[QT_INSTALL_LIBS]/objects-Debug/Gui_resources_2/.qt/rcc/qrc_gui_shaders_init.cpp.o $$[QT_INSTALL_PLUGINS]/platforms/libqxcb.a $$[QT_INSTALL_LIBS]/libQt6XcbQpa.a -lxkbcommon-x11 -lxkbcommon $$[QT_INSTALL_LIBS]/libQt6Gui.a -lGLX -lOpenGL -lEGL -L"$$[QT_INSTALL_PREFIX]/debug/lib" -lharfbuzz -lfontconfig -lexpat $$[QT_INSTALL_LIBS]/libQt6DBus.a $$[QT_INSTALL_LIBS]/libQt6Core.a -ldouble-conversion -lb2 -licui18n -licuuc -licudata -lpcre2-16 -lzstd -lrt -ldbus-1 -lxcb-cursor -lxcb-icccm -lxcb-image -lxcb-keysyms -lxcb-randr -lxcb-render-util -lxcb-shm -lxcb-sync -lxcb-xfixes -lxcb-render -lxcb-shape -lxcb-xkb -lxkbcommon -lX11-xcb -lX11 -lSM -lICE -ldl -lXrender -lX11 -lfreetyped -lbz2d -lpng16d -lz -lbz2d -lpng16d -lz -lm -lbrotlidec -lbrotlicommon -lxcb-xinput -lxcb
