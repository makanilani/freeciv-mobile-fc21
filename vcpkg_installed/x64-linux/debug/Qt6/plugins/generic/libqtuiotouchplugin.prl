QMAKE_PRL_TARGET = libqtuiotouchplugin.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.8.3
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/objects-Debug/Gui_resources_1/.qt/rcc/qrc_qpdf_init.cpp.o $$[QT_INSTALL_LIBS]/objects-Debug/Gui_resources_2/.qt/rcc/qrc_gui_shaders_init.cpp.o $$[QT_INSTALL_PLUGINS]/generic/libqtuiotouchplugin.a $$[QT_INSTALL_LIBS]/libQt6Gui.a -lGLX -lOpenGL -lEGL -L"$$[QT_INSTALL_PREFIX]/debug/lib" -lharfbuzz -lfontconfig -lfreetyped -lbz2d -lpng16d -lz -lbz2d -lpng16d -lbrotlidec -lbrotlicommon -lexpat -lX11 $$[QT_INSTALL_LIBS]/libQt6DBus.a -ldbus-1 -lxkbcommon $$[QT_INSTALL_LIBS]/libQt6Network.a $$[QT_INSTALL_LIBS]/libQt6Core.a -ldouble-conversion -lb2 -licui18n -licuuc -licudata -lpcre2-16 -lrt -lbrotlidec -lbrotlicommon -lm -lzstd -lz -lresolv -lssl -lcrypto -ldl
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/objects-Debug/Gui_resources_1/.qt/rcc/qrc_qpdf_init.cpp.o;$$[QT_INSTALL_LIBS]/objects-Debug/Gui_resources_2/.qt/rcc/qrc_gui_shaders_init.cpp.o;$$[QT_INSTALL_PLUGINS]/generic/libqtuiotouchplugin.a;$$[QT_INSTALL_LIBS]/libQt6Gui.a;-lGLX;-lOpenGL;-lEGL;-L"$$[QT_INSTALL_PREFIX]/debug/lib";-lharfbuzz;-lfontconfig;-lfreetyped;-lbz2d;-lpng16d;-lz;-lbz2d;-lpng16d;-lbrotlidec;-lbrotlicommon;-lexpat;-lX11;$$[QT_INSTALL_LIBS]/libQt6DBus.a;-ldbus-1;-lxkbcommon;$$[QT_INSTALL_LIBS]/libQt6Network.a;$$[QT_INSTALL_LIBS]/libQt6Core.a;-ldouble-conversion;-lb2;-licui18n;-licuuc;-licudata;-lpcre2-16;-lrt;-lbrotlidec;-lbrotlicommon;-lm;-lzstd;-lz;-lresolv;-lssl;-lcrypto;-ldl
