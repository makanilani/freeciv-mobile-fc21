QMAKE_PRL_TARGET = libqsqlite.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.8.3
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6Sql.a $$[QT_INSTALL_LIBS]/libQt6Core.a -L"$$[QT_INSTALL_PREFIX]/debug/lib" -lz -ldouble-conversion -lb2 -lm -licui18n -licuuc -licudata -lpcre2-16 -lzstd -lrt -lsqlite3 -ldl
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6Sql.a;$$[QT_INSTALL_LIBS]/libQt6Core.a;-L"$$[QT_INSTALL_PREFIX]/debug/lib";-lz;-ldouble-conversion;-lb2;-lm;-licui18n;-licuuc;-licudata;-lpcre2-16;-lzstd;-lrt;-lsqlite3;-ldl
