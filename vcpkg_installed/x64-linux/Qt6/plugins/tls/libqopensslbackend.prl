QMAKE_PRL_TARGET = libqopensslbackend.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.8.3
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6Network.a -L"$$[QT_INSTALL_PREFIX]/lib" -lbrotlidec -lbrotlicommon -lresolv $$[QT_INSTALL_LIBS]/libQt6Core.a -lz -ldouble-conversion -lb2 -lm -licui18n -licuuc -licudata -lpcre2-16 -lzstd -lrt -lssl -lcrypto -ldl
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6Network.a;-L"$$[QT_INSTALL_PREFIX]/lib";-lbrotlidec;-lbrotlicommon;-lresolv;$$[QT_INSTALL_LIBS]/libQt6Core.a;-lz;-ldouble-conversion;-lb2;-lm;-licui18n;-licuuc;-licudata;-lpcre2-16;-lzstd;-lrt;-lssl;-lcrypto;-ldl
