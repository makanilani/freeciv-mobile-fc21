QT.core_private.VERSION = 6.8.3
QT.core_private.name = QtCore
QT.core_private.module =
QT.core_private.libs = $$QT_MODULE_LIB_BASE
QT.core_private.includes = $$QT_MODULE_INCLUDE_BASE/QtCore/6.8.3 $$QT_MODULE_INCLUDE_BASE/QtCore/6.8.3/QtCore
QT.core_private.frameworks = 
QT.core_private.depends = core
QT.core_private.uses = 
QT.core_private.module_config = v2 staticlib internal_module
QT.core_private.enabled_features = clock-gettime doubleconversion system-doubleconversion dladdr futimens getauxval getentropy icu inotify system-libb2 linkat memmem memrchr mimetype-database system-pcre2 poll_ppoll posix_sem posix_shm renameat2 sysv_sem sysv_shm sha3-fast hijricalendar timezone_locale datetimeparser forkfd_pidfd pcre2 gc_binaries reduce_exports x86intrin sse2 sse3 ssse3 sse4_1 sse4_2 avx f16c avx2 avx512f avx512er avx512cd avx512pf avx512dq avx512bw avx512vl avx512ifma avx512vbmi avx512vbmi2 aesni vaes rdrnd rdseed shani localtime_r posix_fallocate alloca_h alloca system-zlib dbus dbus-linked gui network printsupport sql testlib widgets xml openssl dlopen relocatable intelcet glibc_fortify_source stack_protector stack_clash_protection libstdcpp_assertions relro_now_linker force_debug_info largefile precompile_header enable_new_dtags sse2 sse3 ssse3 sse4_1 sse4_2 avx f16c avx2 avx512f avx512er avx512cd avx512pf avx512dq avx512bw avx512vl avx512ifma avx512vbmi avx512vbmi2 aesni vaes rdrnd rdseed shani
QT.core_private.disabled_features = broken-threadlocal-dtors glib journald poll_pollts poll_poll poll_select qqnx_pps slog2 syslog backtrace cxx23_stacktrace cpp-winrt lttng etw ctf poll-exit-on-error openssl-hash use_bfd_linker use_gold_linker use_lld_linker use_mold_linker android-style-assets developer-build private_tests debug elf_private_full_version no_direct_extern_access mips_dsp mips_dspr2 neon arm_crc32 arm_crypto localtime_s alloca_malloc_h stdlib-libcpp libudev trivial_auto_var_init_pattern libcpp_hardening
QMAKE_INCDIR_OPENSSL = $$[QT_INSTALL_PREFIX]/include
QMAKE_LIBS_OPENSSL = -L"$$[QT_INSTALL_PREFIX]/lib" -lssl -ldl -lcrypto -ldl -ldl
QMAKE_INCDIR_DOUBLECONVERSION = $$[QT_INSTALL_PREFIX]/include
QMAKE_LIBS_DOUBLECONVERSION = -L"$$[QT_INSTALL_PREFIX]/lib" -ldouble-conversion
QMAKE_INCDIR_ICU = $$[QT_INSTALL_PREFIX]/include
QMAKE_LIBS_ICU = -L"$$[QT_INSTALL_PREFIX]/lib" -licudata -licuuc -licui18n
QMAKE_LIBS_LIBATOMIC = 
QMAKE_INCDIR_LIBB2 = $$[QT_INSTALL_PREFIX]/lib/pkgconfig/../../include
QMAKE_LIBS_LIBB2 = -L"$$[QT_INSTALL_PREFIX]/lib" -lb2
QMAKE_LIBS_LIBRT = -lrt
QMAKE_INCDIR_PCRE2 = $$[QT_INSTALL_PREFIX]/include
QMAKE_DEFINES_PCRE2 = PCRE2_STATIC
QMAKE_LIBS_PCRE2 = -L"$$[QT_INSTALL_PREFIX]/lib" -lpcre2-16
