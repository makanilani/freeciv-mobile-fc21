QT.gui_private.VERSION = 6.8.3
QT.gui_private.name = QtGui
QT.gui_private.module =
QT.gui_private.libs = $$QT_MODULE_LIB_BASE
QT.gui_private.includes = $$QT_MODULE_INCLUDE_BASE/QtGui/6.8.3 $$QT_MODULE_INCLUDE_BASE/QtGui/6.8.3/QtGui
QT.gui_private.frameworks = 
QT.gui_private.depends = core_private gui
QT.gui_private.uses = xkbcommon
QT.gui_private.module_config = v2 staticlib internal_module
QT.gui_private.enabled_features = evdev freetype system-freetype fontconfig harfbuzz system-harfbuzz linuxfb vnc vkgen egl_x11 eglfs eglfs_x11 gif ico jpeg system-jpeg png system-png imageio-text-loading tuiotouch xcb-glx xcb-egl-plugin xcb-native-painting xrender xcb-xlib xcb-sm system-xcb-xinput xkbcommon xkbcommon-x11 xlib multiprocess raster-64bit raster-fp
QT.gui_private.disabled_features = accessibility-atspi-bridge directfb directwrite directwrite3 direct2d direct2d1_1 qqnx_imf integrityfb kms drm_atomic libinput integrityhid libinput-axis-api libinput-hires-wheel-support vsp2 mtdev vkkhrdisplay eglfs_brcm eglfs_egldevice eglfs_gbm eglfs_vsp2 eglfs_mali eglfs_viv eglfs_rcar eglfs_viv_wl eglfs_openwfd tslib graphicsframecapture
QMAKE_INCDIR_EGL = $$[QT_INSTALL_PREFIX]/include
QMAKE_LIBS_EGL = -lEGL
QMAKE_INCDIR_FREETYPE = $$[QT_INSTALL_PREFIX]/include
QMAKE_LIBS_FREETYPE = -L"$$[QT_INSTALL_PREFIX]/lib" -lbrotlicommon -lbrotlidec -lpng16 -lbz2 -lz -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lfreetype -lm
QMAKE_INCDIR_FONTCONFIG = $$[QT_INSTALL_PREFIX]/include
QMAKE_LIBS_FONTCONFIG = -L"$$[QT_INSTALL_PREFIX]/lib" -lfontconfig -lexpat -lbrotlicommon -lbrotlidec -lpng16 -lbz2 -lz -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lbrotlicommon -lbrotlidec -lfreetype -lm
QMAKE_INCDIR_HARFBUZZ = $$[QT_INSTALL_PREFIX]/include/harfbuzz $$[QT_INSTALL_PREFIX]/include
QMAKE_LIBS_HARFBUZZ = -L"$$[QT_INSTALL_PREFIX]/lib" -lharfbuzz -lfreetype
QMAKE_INCDIR_LIBJPEG = $$[QT_INSTALL_PREFIX]/include
QMAKE_LIBS_LIBJPEG = -L"$$[QT_INSTALL_PREFIX]/lib" -ljpeg
QMAKE_INCDIR_LIBPNG = $$[QT_INSTALL_PREFIX]/include
QMAKE_LIBS_LIBPNG = -L"$$[QT_INSTALL_PREFIX]/lib" -lpng16 -lm -lz
QMAKE_LIBS_OPENGL = -lGLX -lOpenGL
QMAKE_LIBS_WAYLAND_SERVER = -lwayland-server
QMAKE_LIBS_WAYLAND_CLIENT = -lwayland-client
QMAKE_LIBS_XLIB = -lX11
QMAKE_LIBS_X11SM = -lICE -lSM
QMAKE_LIBS_XCB = -lxcb
QMAKE_LIBS_XCB_CURSOR = -lxcb-cursor -lxcb
QMAKE_LIBS_XCB_ICCCM = -lxcb-icccm -lxcb
QMAKE_LIBS_XCB_IMAGE = -lxcb-image -lxcb-shm -lxcb
QMAKE_LIBS_XCB_KEYSYMS = -lxcb-keysyms -lxcb
QMAKE_LIBS_XCB_RENDERUTIL = -lxcb-render-util -lxcb-render -lxcb
QMAKE_LIBS_XCB_RANDR = -lxcb-randr -lxcb
QMAKE_LIBS_XCB_SHAPE = -lxcb-shape -lxcb
QMAKE_LIBS_XCB_SHM = -lxcb-shm -lxcb
QMAKE_LIBS_XCB_SYNC = -lxcb-sync -lxcb
QMAKE_LIBS_XCB_XFIXES = -lxcb-xfixes -lxcb-shape -lxcb-render -lxcb
QMAKE_LIBS_XCB_XLIB = -lX11-xcb
QMAKE_LIBS_XCB_XKB = -lxcb-xkb -lxcb
QMAKE_LIBS_XCB_RENDER = -lxcb-render -lxcb
QMAKE_LIBS_XCB_GLX = -lxcb-glx -lxcb
QMAKE_LIBS_XCB_XINPUT = -lxcb-xinput -lxcb
QMAKE_LIBS_XKBCOMMON = -lxkbcommon
QMAKE_LIBS_XKBCOMMON_X11 = -lxkbcommon -lxkbcommon-x11
QMAKE_LIBS_XRENDER = -lX11 -lXrender
