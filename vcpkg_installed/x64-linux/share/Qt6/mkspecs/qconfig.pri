QT_ARCH = x86_64
QT_BUILDABI = x86_64-little_endian-lp64
QT_LIBCPP_ABI_TAG = 
QT.global.enabled_features = version_tagging static pkg-config reduce_relocations signaling_nan zstd thread future concurrent dbus openssl-linked opensslv30 static intelcet glibc_fortify_source stack_protector stack_clash_protection libstdcpp_assertions relro_now_linker static reduce_exports reduce_relocations openssl
QT.global.disabled_features = shared cross_compile debug_and_release separate_debug_info appstore-compliant simulator_and_device rpath force_asserts framework c++20 c++2a c++2b wasm-simd128 wasm-exceptions opensslv11
QT.global.disabled_features += release build_all
QT_CONFIG += static reduce_exports reduce_relocations openssl debug
CONFIG += debug  static plugin_manifest intelcet glibc_fortify_source stack_protector stack_clash_protection libstdcpp_assertions relro_now_linker
QT_VERSION = 6.8.3
QT_MAJOR_VERSION = 6
QT_MINOR_VERSION = 8
QT_PATCH_VERSION = 3

QT_GCC_MAJOR_VERSION = 13
QT_GCC_MINOR_VERSION = 3
QT_GCC_PATCH_VERSION = 0
